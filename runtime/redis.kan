-- Stage B types over the carried Bytes and Words families.
def Unit : Type 0 := prod ()

mu Encoding : Type 0 :=
| Binary : Encoding
| Int64 : Encoding

mu RedisType : Type 0 :=
| Str : Encoding -> RedisType
| Hash : RedisType
| List : RedisType
| Set : RedisType
| ZSet : RedisType
| Stream : RedisType

mu Tag : Type 0 :=
| tag : Bytes -> Tag

mu Key : (0 t : RedisType) -> (0 g : Tag) -> Type 0 :=
| keyBytes : (0 t : RedisType) -> (0 g : Tag) -> Bytes -> Key t g

mu Signed64 : Type 0 :=
| signed64Bytes : Bytes -> Signed64

mutual
mu Reply : Type 0 :=
| nil : Reply
| int : Signed64 -> Reply
| bulk : Bytes -> Reply
| status : Bytes -> Reply
| err : Bytes -> Reply
| array : Replies -> Reply
mu Replies : Type 0 :=
| repliesNil : Replies
| repliesCons : Reply -> Replies -> Replies
end

-- Byte payloads retain the fault tag through the inherited proof erasure
-- and leave room for the host's diagnostic text.
def Fault : Type 0 := sum (Bytes, Bytes, Bytes, Bytes, Bytes, Bytes)
def Noscript : Fault := inj 0 of 6 b""
def Busy : Fault := inj 1 of 6 b""
def Oom : Fault := inj 2 of 6 b""
def Network : Fault := inj 3 of 6 b""
def Http : Fault := inj 4 of 6 b""
def Discarded : Fault := inj 5 of 6 b""

mu Script (0 A : Type 0) : (0 g : Tag) -> Type 0 :=
| pure : (0 g : Tag) -> A -> Script A g
| incr : (0 g : Tag) -> Key (Str Int64) g -> (Reply -> Script A g) -> Script A g
| get : (0 e : Encoding) -> (0 g : Tag) -> Key (Str e) g -> (Reply -> Script A g) -> Script A g
| set : (0 g : Tag) -> Key (Str Binary) g -> Bytes -> (Reply -> Script A g) -> Script A g
| setInt64 : (0 g : Tag) -> Key (Str Int64) g -> Signed64 -> (Reply -> Script A g) -> Script A g
| incrby : (0 g : Tag) -> Key (Str Int64) g -> Signed64 -> (Reply -> Script A g) -> Script A g
| decr : (0 g : Tag) -> Key (Str Int64) g -> (Reply -> Script A g) -> Script A g
| del : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> (Reply -> Script A g) -> Script A g
| exists : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> (Reply -> Script A g) -> Script A g
| hset : (0 g : Tag) -> Key Hash g -> Bytes -> Bytes -> (Reply -> Script A g) -> Script A g
| hget : (0 g : Tag) -> Key Hash g -> Bytes -> (Reply -> Script A g) -> Script A g
| hdel : (0 g : Tag) -> Key Hash g -> Bytes -> (Reply -> Script A g) -> Script A g
| hexists : (0 g : Tag) -> Key Hash g -> Bytes -> (Reply -> Script A g) -> Script A g
| hlen : (0 g : Tag) -> Key Hash g -> (Reply -> Script A g) -> Script A g
| hincrby : (0 g : Tag) -> Key Hash g -> Bytes -> Signed64 -> (Reply -> Script A g) -> Script A g
| sadd : (0 g : Tag) -> Key Set g -> Bytes -> (Reply -> Script A g) -> Script A g
| srem : (0 g : Tag) -> Key Set g -> Bytes -> (Reply -> Script A g) -> Script A g
| sismember : (0 g : Tag) -> Key Set g -> Bytes -> (Reply -> Script A g) -> Script A g
| scard : (0 g : Tag) -> Key Set g -> (Reply -> Script A g) -> Script A g
| lpush : (0 g : Tag) -> Key List g -> Bytes -> (Reply -> Script A g) -> Script A g
| rpush : (0 g : Tag) -> Key List g -> Bytes -> (Reply -> Script A g) -> Script A g
| lpop : (0 g : Tag) -> Key List g -> (Reply -> Script A g) -> Script A g
| rpop : (0 g : Tag) -> Key List g -> (Reply -> Script A g) -> Script A g
| llen : (0 g : Tag) -> Key List g -> (Reply -> Script A g) -> Script A g
| lindex : (0 g : Tag) -> Key List g -> Signed64 -> (Reply -> Script A g) -> Script A g
| lset : (0 g : Tag) -> Key List g -> Signed64 -> Bytes -> (Reply -> Script A g) -> Script A g
| ltrim : (0 g : Tag) -> Key List g -> Signed64 -> Signed64 -> (Reply -> Script A g) -> Script A g
| lrange : (0 g : Tag) -> Key List g -> Signed64 -> Signed64 -> (Reply -> Script A g) -> Script A g
| smembers : (0 g : Tag) -> Key Set g -> (Reply -> Script A g) -> Script A g
| hgetall : (0 g : Tag) -> Key Hash g -> (Reply -> Script A g) -> Script A g
| hkeys : (0 g : Tag) -> Key Hash g -> (Reply -> Script A g) -> Script A g
| hvals : (0 g : Tag) -> Key Hash g -> (Reply -> Script A g) -> Script A g
| sunion : (0 g : Tag) -> Key Set g -> Key Set g -> (Reply -> Script A g) -> Script A g
| sinter : (0 g : Tag) -> Key Set g -> Key Set g -> (Reply -> Script A g) -> Script A g
| sdiff : (0 g : Tag) -> Key Set g -> Key Set g -> (Reply -> Script A g) -> Script A g
| sunionstore : (0 g : Tag) -> Key Set g -> Key Set g -> Key Set g -> (Reply -> Script A g) -> Script A g
| sinterstore : (0 g : Tag) -> Key Set g -> Key Set g -> Key Set g -> (Reply -> Script A g) -> Script A g
| sdiffstore : (0 g : Tag) -> Key Set g -> Key Set g -> Key Set g -> (Reply -> Script A g) -> Script A g
| smove : (0 g : Tag) -> Key Set g -> Key Set g -> Bytes -> (Reply -> Script A g) -> Script A g
| expire : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> Signed64 -> (Reply -> Script A g) -> Script A g
| pexpire : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> Signed64 -> (Reply -> Script A g) -> Script A g
| ttl : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> (Reply -> Script A g) -> Script A g
| pttl : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> (Reply -> Script A g) -> Script A g
| persist : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> (Reply -> Script A g) -> Script A g
| expireat : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> Signed64 -> (Reply -> Script A g) -> Script A g
| pexpireat : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> Signed64 -> (Reply -> Script A g) -> Script A g
| expiretime : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> (Reply -> Script A g) -> Script A g
| pexpiretime : (0 t : RedisType) -> (0 g : Tag) -> Key t g -> (Reply -> Script A g) -> Script A g

mu Client (0 A : Type 0) : Type 0 :=
| done : A -> Client A
| inv : (0 g : Tag) -> Script Reply g -> (Reply -> Client A) -> Client A
| fail : Fault -> Client A
