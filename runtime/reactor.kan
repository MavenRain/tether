-- Shared byte and argument lists for the generic reactor host.
mu Bytes : Type 0 with
| bytesNil : Bytes
| bytesCons : Nat -> Bytes -> Bytes

mu Words : Type 0 with
| wordsNil : Words
| wordsCons : Bytes -> Words -> Words

def emptyBytes : Bytes := bytesNil
def consBytes : Nat -> Bytes -> Bytes :=
  fun (head : Nat) (tail : Bytes) => bytesCons head tail
def bytesEmpty : Bytes -> Nat := fun (bytes : Bytes) =>
  case bytes as value in Bytes return Nat with
  | bytesNil => 1
  | bytesCons head tail => 0
def bytesHead : Bytes -> Nat := fun (bytes : Bytes) =>
  case bytes as value in Bytes return Nat with
  | bytesNil => 0
  | bytesCons head tail => head
def bytesTail : Bytes -> Bytes := fun (bytes : Bytes) =>
  case bytes as value in Bytes return Bytes with
  | bytesNil => bytesNil
  | bytesCons head tail => tail

def emptyWords : Words := wordsNil
def consWords : Bytes -> Words -> Words :=
  fun (head : Bytes) (tail : Words) => wordsCons head tail
def wordsEmpty : Words -> Nat := fun (words : Words) =>
  case words as value in Words return Nat with
  | wordsNil => 1
  | wordsCons head tail => 0
def wordsHead : Words -> Bytes := fun (words : Words) =>
  case words as value in Words return Bytes with
  | wordsNil => bytesNil
  | wordsCons head tail => head
def wordsTail : Words -> Words := fun (words : Words) =>
  case words as value in Words return Words with
  | wordsNil => wordsNil
  | wordsCons head tail => tail

-- Consume the first list structurally, accumulating through tail calls.
def rec bytesReverseOnto : Bytes -> Bytes -> Bytes :=
  fun (bytes : Bytes) (suffix : Bytes) =>
    case bytes as value in Bytes return Bytes with
    | bytesNil => suffix
    | bytesCons head tail => bytesReverseOnto tail (bytesCons head suffix)

-- Reverse the left list twice to preserve its order without growing the
-- Wasm call stack.  The right list is shared by the resulting list.
def bytesAppend : Bytes -> Bytes -> Bytes :=
  fun (left : Bytes) (right : Bytes) =>
    bytesReverseOnto (bytesReverseOnto left bytesNil) right
