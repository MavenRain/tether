module QueueInsert
schema jobs : String -> Key List tag b"queue"

def seed : Script Reply (tag b"queue") := do {
  r <- rpushMany Reply (tag b"queue") (jobs b"mail")
    (bulkMore b"welcome:alice" (bulkOne b"welcome:bob"));
  pure Reply (tag b"queue") r
}
def insert : Script Reply (tag b"queue") := do {
  _ <- linsertBefore Reply (tag b"queue") (jobs b"mail") b"welcome:bob" b"priority:carol";
  r <- linsertAfter Reply (tag b"queue") (jobs b"mail") b"welcome:bob" b"audit:bob";
  pure Reply (tag b"queue") r
}
def preview : Script Reply (tag b"queue") := do {
  r <- lrange Reply (tag b"queue") (jobs b"mail") (int64 b"0") (int64 b"-1");
  pure Reply (tag b"queue") r
}
def absent : Script Reply (tag b"queue") := do {
  r <- linsertBefore Reply (tag b"queue") (jobs b"mail") b"missing" b"unused";
  pure Reply (tag b"queue") r
}
def main : Client Reply := do {
  _ <- inv Reply (tag b"queue") seed;
  _ <- inv Reply (tag b"queue") insert;
  r <- inv Reply (tag b"queue") preview;
  done Reply r
}
def length : Client Reply := do {
  _ <- inv Reply (tag b"queue") seed;
  r <- inv Reply (tag b"queue") insert;
  done Reply r
}
def missingPivot : Client Reply := do {
  _ <- inv Reply (tag b"queue") seed;
  r <- inv Reply (tag b"queue") absent;
  done Reply r
}
